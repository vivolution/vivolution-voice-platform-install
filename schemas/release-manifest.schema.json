{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivolution.ae/schemas/voice-platform-release-manifest-v1.json",
  "title": "Vivolution Voice Platform release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "release", "source_commit", "artifact", "sbom", "published_at"],
  "properties": {
    "schema_version": {"const": 1},
    "product": {"const": "Vivolution Voice Platform"},
    "release": {"type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+(?:-rc[0-9]+)?$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "published_at": {"type": "string", "format": "date-time"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "sha256", "bytes", "archive_root", "entrypoint"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#\\s]+(?:[/?#][^\\s]*)?$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "archive_root": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "entrypoint": {"const": "installer/install.sh"}
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#\\s]+(?:[/?#][^\\s]*)?$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
